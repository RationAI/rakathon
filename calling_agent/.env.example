# Copy to the repository root as .env. The local console needs no app token.
OPENAI_API_KEY=
PUBLIC_ORIGIN=http://localhost:8080
ORGANIZATION_NAME=Ukázkový program prevence
VOICE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-6-sol
BACKEND_REASONING_EFFORT=none
GREETING_MODEL=gpt-4o-mini-tts
VOICE=coral
TONE=positive
GREETING_SPEED=1.15
MAX_CALL_SECONDS=600

# Leave disabled until testing on your own explicitly permitted number.
ENABLE_OUTBOUND_CALLS=false
OUTBOUND_ALLOWLIST=
SIP_PROVIDER_URL=
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=
